# --- Client (safe to expose in the browser bundle) ---
# Found in Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server only (Vercel env vars — NEVER prefix with VITE_ or ship to client) ---
# Found in Supabase dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Found in DeepSeek platform -> API keys
DEEPSEEK_API_KEY=your-deepseek-api-key
